{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5
  ],
  "description": "Owns the single shared todo list: create, list, complete/uncomplete, and delete todo items. Stores items in its own Postgres database. Does not manage users or authentication itself — it verifies the gateway's signed assertion for every request.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "simplest-todo4112-todo-db",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-todo4112-c8896896",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
