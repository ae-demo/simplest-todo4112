{
  "name": "todo-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "todo-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5
  ],
  "description": "Single-page app for the shared todo list: sign in, view the list, add a todo, toggle done/not-done, and delete a todo. Holds no data of its own — everything is read from and written to todo-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "todo-api",
      "wiring": {
        "endpoint": {
          "component": "simplest-todo4112-todo-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TODO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-todo4112-c8896896",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
